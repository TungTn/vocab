# Environment Mode
NODE_ENV=development
PORT=4000

# PostgreSQL & Prisma
POSTGRES_USER=linguaflow
POSTGRES_PASSWORD=linguaflow_secret
POSTGRES_DB=linguaflow_db
POSTGRES_PORT=5435
DATABASE_URL=postgresql://linguaflow:linguaflow_secret@localhost:5435/linguaflow_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=redis_secret

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET=lingua-media

# JWT Auth
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_prod_123456
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_prod_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
