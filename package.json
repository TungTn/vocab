{
  "name": "linguaflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LinguaFlow - Smart Multiplatform Language Learning Platform",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @linguaflow/api dev",
    "dev:web": "pnpm --filter @linguaflow/web dev",
    "dev:mobile": "pnpm --filter @linguaflow/mobile dev",
    "db:migrate": "pnpm --filter @linguaflow/api exec prisma db push",
    "db:seed": "pnpm --filter @linguaflow/api exec ts-node prisma/seed.ts",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
